# Fill locally and save as .env; never commit a real API key.
# Use either BASE_URL (for example https://provider.example/v1)
# or CHAT_URL (the full chat/completions endpoint), not both.
RESOLVE_LLM_BASE_URL=
RESOLVE_LLM_CHAT_URL=
RESOLVE_LLM_MODEL=
RESOLVE_LLM_API_KEY=
RESOLVE_LLM_TIMEOUT_SECONDS=20
RESOLVE_LLM_JSON_MODE=false

# Optional read-only evidence endpoints.
RESOLVE_CRM_EVIDENCE_URL=
RESOLVE_OMS_EVIDENCE_URL=
RESOLVE_PAYMENT_EVIDENCE_URL=
RESOLVE_LOGISTICS_EVIDENCE_URL=
RESOLVE_KNOWLEDGE_EVIDENCE_URL=

# Required only when running Docker Compose. Use a URL-safe value.
RESOLVE_POSTGRES_PASSWORD=

# Optional idempotent business action API and status query.
RESOLVE_ACTION_API_URL=
RESOLVE_ACTION_STATUS_URL=
RESOLVE_ACTION_API_TOKEN=

# Operator identity for takeover/release and authenticated approvals.
RESOLVE_OPERATOR_ID=
RESOLVE_OPERATOR_TOKEN=

# Optional OTLP collector endpoint for API and Worker traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
